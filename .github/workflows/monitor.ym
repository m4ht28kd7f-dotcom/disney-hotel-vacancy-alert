name: Disney Hotel Vacancy Monitor

on:
  workflow_dispatch:
  schedule:
    # 日本時間 05:00〜02:59 の間、約10分ごと
    - cron: "7-57/10 0-2,5-23 * * *"
      timezone: "Asia/Tokyo"

permissions:
  contents: write

jobs:
  monitor:
    runs-on: ubuntu-latest

    steps:
      - name: リポジトリを取得
        uses: actions/checkout@v4

      - name: Pythonをセットアップ
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: 必要なライブラリをインストール
        run: |
          pip install playwright
          playwright install chromium

      - name: 空室チェック
        env:
          SMTP_USER: ${{ secrets.SMTP_USER }}
          SMTP_PASSWORD: ${{ secrets.SMTP_PASSWORD }}
          ALERT_TO: ${{ secrets.ALERT_TO }}
        run: |
          python monitor.py

      - name: 空室状態を保存
        run: |
          if git diff --quiet -- availability_state.json && [ -f availability_state.json ]; then
            echo "状態に変更なし"
          else
            git config user.name "github-actions[bot]"
            git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
            git add availability_state.json
            git commit -m "Update availability state" || true
            git push
          fi
